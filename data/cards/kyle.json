  {"id": "kyle_charge_order", "name": "돌격 명령", "owner": "kyle", "type": "attack", "rarity": "epic", "pool": "reward", "cost": {"neigong": 2, "mana": 0}, "target": "enemy", "tags": ["kyle_swift"], "castLine": {"speaker": "kyle", "face": "resolve", "text": "전원, 돌격!"}, "effects": [{"op": "damage", "amount": 40, "scale": {"per": "cardsPlayed", "amount": 40, "max": 240}}], "upgrade": {"growth": [20], "plus4": {"name": "깃발", "effects": [{"op": "block", "amount": 40, "target": "all_allies"}]}, "plus5": {"name": "선두", "cost": {"neigong": 1, "mana": 0}}}, "flavor": "검이 앞을 가리키자 깃발이 따라 나부꼈다. 그 뒤로 모두가 달렸다."},
  {"id": "kyle_dumpling_shop", "name": "기사의 만두집", "owner": "kyle", "type": "power", "rarity": "rare", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "self", "keywords": ["exhaust"], "tags": ["kyle_blood"], "effects": [{"op": "apply_status", "status": "p_dumpling_shop", "stacks": 1, "target": "self"}, {"op": "heal", "amount": 30, "target": "all_allies"}], "upgrade": {"growth": [0, 20], "plus4": {"name": "한 접시 더", "effects": [{"op": "heal", "amount": 40, "target": "all_allies"}]}, "plus5": {"name": "단골", "cost": {"neigong": 0, "mana": 0}}}, "flavor": "검을 간판 위에 걸었다. \"기사의 만두집\". 김이 모락모락 올랐다."},
  {"id": "kyle_bluff", "name": "허풍", "owner": "kyle", "type": "skill", "rarity": "common", "pool": "reward", "cost": {"neigong": 0, "mana": 0}, "target": "enemy", "keywords": ["exhaust"], "tags": ["kyle_swift"], "effects": [{"op": "apply_status", "status": "weak", "stacks": 1}, {"op": "draw", "amount": 1}], "upgrade": {"growth": [1, 0], "plus4": {"name": "더 큰 허풍", "effects": [{"op": "apply_status", "status": "vulnerable", "stacks": 1}]}, "plus5": {"name": "진짜가 된 허풍", "removeKeywords": ["exhaust"]}}, "flavor": "\"로웬 제일의 검이 여기 있다!\" 가슴을 내밀고 크게 웃었다. 상대가 머뭇거렸다."},
  {"id": "kyle_dawn_drill", "name": "새벽 수련", "owner": "kyle", "type": "skill", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "self", "tags": ["kyle_blood"], "effects": [{"op": "apply_status", "status": "strength", "stacks": 1, "target": "self"}, {"op": "block", "amount": 40, "target": "self"}], "upgrade": {"growth": [0, 20], "plus4": {"name": "땀 한 방울", "effects": [{"op": "draw", "amount": 1}]}, "plus5": {"name": "백 번의 휘두름", "cost": {"neigong": 0, "mana": 0}}}, "flavor": "해가 뜨기 전, 카일은 검을 백 번 휘둘렀다. 매일 그랬다."},
  {"id": "kyle_sword_care", "name": "검 손질", "owner": "kyle", "type": "skill", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 0, "mana": 0}, "target": "none", "tags": ["kyle_swift"], "effects": [{"op": "draw", "amount": 2}, {"op": "discard", "amount": 1}], "upgrade": {"growth": [1, 0], "plus4": {"name": "기름칠", "effects": [{"op": "block", "amount": 40, "target": "self"}]}, "plus5": {"name": "익숙한 천", "cost": {"neigong": 0, "mana": 0}}}, "flavor": "천으로 검날을 닦았다. 칼날에 비친 얼굴이 조금 피곤해 보였다."},
  {"id": "kyle_knight_pride", "name": "기사의 긍지", "owner": "kyle", "type": "skill", "rarity": "rare", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "self", "tags": ["kyle_blood"], "effects": [{"op": "lose_hp", "amount": 30, "target": "self"}, {"op": "block", "amount": 120, "target": "self"}, {"op": "apply_status", "status": "strength", "stacks": 1, "target": "self"}], "upgrade": {"growth": [0, 30, 0], "plus4": {"name": "찌그러진 갑옷", "effects": [{"op": "block", "amount": 40, "target": "all_allies"}]}, "plus5": {"name": "꺾이지 않는", "cost": {"neigong": 0, "mana": 0}}}, "flavor": "갑옷은 찌그러졌다. 그래도 기사는 쓰러지지 않았다."}
