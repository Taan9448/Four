  {"id": "kyle_knight_oath", "name": "기사의 맹세", "owner": "kyle", "type": "power", "rarity": "rare", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "self", "keywords": ["exhaust"], "tags": ["kyle_blood"], "effects": [{"op": "apply_status", "status": "p_knight_oath", "stacks": 1, "target": "self"}, {"op": "block", "amount": 30, "target": "self"}], "upgrade": {"growth": [0, 20], "plus4": {"name": "무릎 꿇은 기사", "effects": [{"op": "apply_status", "status": "strength", "stacks": 1, "target": "self"}]}, "plus5": {"name": "가벼운 맹세", "cost": {"neigong": 0, "mana": 0}}}, "flavor": "검을 거꾸로 세우고 무릎을 꿇었다. 다치는 만큼 지키겠다고."},
  {"id": "kyle_white_snowflake", "name": "흰 눈송이", "owner": "kyle", "type": "attack", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "enemy", "tags": ["kyle_blood"], "effects": [{"op": "damage", "amount": 0, "scale": {"per": "missingHp", "amount": 0.5, "max": 150}}], "upgrade": {"growth": [20], "plus4": {"name": "붉은 눈", "effects": [{"op": "apply_status", "status": "weak", "stacks": 1}]}, "plus5": {"name": "로웬의 겨울", "effects": [{"op": "draw", "amount": 1}]}}, "flavor": "푸른 바탕에 흰 눈송이. 로웬의 문장은 피가 묻어야 비로소 선명해졌다."},
  {"id": "kyle_princess_ice", "name": "왕녀의 얼음", "owner": "kyle", "type": "skill", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "ally", "effects": [{"op": "remove_status", "status": "chill", "target": "ally"}, {"op": "heal", "amount": 70, "target": "ally"}], "upgrade": {"growth": [0, 20], "plus4": {"name": "녹이는 손", "effects": [{"op": "block", "amount": 40, "target": "ally"}]}, "plus5": {"name": "왕녀의 눈물", "effects": [{"op": "remove_status", "status": "burn", "target": "ally"}]}}, "flavor": "얼음 왕관이 녹아 물방울이 되었다. 그녀는 처음으로 따뜻하다고 말했다."},
  {"id": "kyle_returned_blade", "name": "되돌린 검", "owner": "kyle", "type": "attack", "rarity": "rare", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "enemy", "tags": ["kyle_swift"], "effects": [{"op": "dispel"}, {"op": "damage", "amount": 90}], "upgrade": {"growth": [0, 30], "plus4": {"name": "되받아치기", "effects": [{"op": "apply_status", "status": "vulnerable", "stacks": 1}]}, "plus5": {"name": "눈을 감고", "effects": [{"op": "draw", "amount": 1}]}}, "flavor": "눈을 감고 검을 휘둘렀다. 날아온 마법이 온 길로 되돌아갔다."},
  {"id": "kyle_command", "name": "구령", "owner": "kyle", "type": "skill", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 0, "mana": 0}, "target": "none", "keywords": ["exhaust"], "tags": ["kyle_swift"], "effects": [{"op": "block", "amount": 20, "target": "all_allies"}, {"op": "draw", "amount": 1}], "upgrade": {"growth": [10, 0], "plus4": {"name": "대열", "effects": [{"op": "block", "amount": 20, "target": "all_allies"}]}, "plus5": {"name": "익숙한 구령", "removeKeywords": ["exhaust"]}}, "flavor": "\"하나, 둘! 방패!\" 농부들의 괭이가 한 줄로 섰다."},
  {"id": "kyle_shadow_bridge", "name": "그림자 다리", "owner": "kyle", "type": "skill", "rarity": "legendary", "pool": "reward", "cost": {"neigong": 2, "mana": 0}, "target": "self", "keywords": ["exhaust"], "tags": ["kyle_blood"], "castLine": {"speaker": "kyle", "face": "resolve", "text": "가! 여긴 내가 막는다!"}, "effects": [{"op": "taunt", "stacks": 2, "target": "self"}, {"op": "block", "amount": 250, "target": "self"}, {"op": "lose_hp", "amount": 100, "target": "self"}], "upgrade": {"growth": [0, 50, 0], "plus4": {"name": "버티는 다리", "effects": [{"op": "keep_block", "target": "self"}]}, "plus5": {"name": "되돌아오는 기사", "effects": [{"op": "heal", "amount": 80, "target": "self"}]}}, "flavor": "좁은 다리 위, 거대한 그림자 앞에 기사 하나가 섰다. 뒤에는 친구들이 있었다."},
  {"id": "kyle_double_cut", "name": "두 번 베기", "owner": "kyle", "type": "attack", "rarity": "common", "pool": "reward", "cost": {"neigong": 1, "mana": 0}, "target": "enemy", "tags": ["kyle_swift"], "effects": [{"op": "damage", "amount": 40, "times": 2}], "upgrade": {"growth": [10], "plus4": {"name": "세 번째 칼", "effects": [{"op": "damage", "amount": 40}]}, "plus5": {"name": "익숙한 손", "effects": [{"op": "draw", "amount": 1}]}}, "flavor": "한 번 베고, 돌아오며 또 한 번. 은빛 선 두 줄이 나란히 남았다."},
