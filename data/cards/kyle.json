  {"id": "kyle_rowen_step", "name": "로웬의 보법", "owner": "kyle", "type": "skill", "rarity": "common", "pool": "reward", "cost": {"neigong": 0, "mana": 0}, "target": "self", "tags": ["kyle_swift"], "effects": [{"op": "cost_next", "amount": 1}, {"op": "block", "amount": 30, "target": "self"}], "upgrade": {"growth": [0, 20], "plus4": {"name": "가벼운 발", "effects": [{"op": "draw", "amount": 1}]}, "plus5": {"name": "빛의 발자국", "effects": [{"op": "cost_next", "amount": 1}]}}, "flavor": "로웬의 기사는 발로 싸운다. 카일의 발자국은 늘 한 박자 앞에 있었다."},
