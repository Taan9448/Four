  {"id": "elia_sealing_hand", "name": "봉인의 손", "owner": "elia", "type": "skill", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 0, "mana": 1}, "target": "self", "effects": [{"op": "apply_status", "status": "seal", "stacks": 2, "target": "self"}], "upgrade": {"growth": [1], "plus4": {"name": "감싸는 손", "effects": [{"op": "block", "amount": 40, "target": "self"}]}, "plus5": {"name": "가벼운 손", "cost": {"neigong": 0, "mana": 0}}}, "flavor": "손바닥에 옅은 원이 떠올랐다. 금이 벌어지려다 멈칫했다."},
