  {"id": "elia_discharge", "name": "방전", "owner": "elia", "type": "attack", "rarity": "uncommon", "pool": "reward", "cost": {"neigong": 0, "mana": 2}, "target": "enemy", "tags": ["elia_shock"], "effects": [{"op": "damage", "amount": 60, "element": "lightning"}, {"op": "damage", "amount": 80, "condition": {"targetHasStatus": "paralyze"}}], "upgrade": {"growth": [20, 20], "plus4": {"name": "남은 전하", "effects": [{"op": "apply_status", "status": "vulnerable", "stacks": 1}]}, "plus5": {"name": "짧은 방전", "cost": {"neigong": 0, "mana": 1}}}, "flavor": "굳어 버린 것에게 쌓아 둔 번개를 한꺼번에 쏟았다."},
  {"id": "elia_thunderbolt", "name": "낙뢰", "owner": "elia", "type": "attack", "rarity": "rare", "pool": "reward", "cost": {"neigong": 0, "mana": 4}, "target": "enemy", "tags": ["elia_shock"], "effects": [{"op": "damage", "amount": 100, "element": "lightning"}, {"op": "apply_status", "status": "shock", "stacks": 2}], "upgrade": {"growth": [30, 0], "plus4": {"name": "울림", "effects": [{"op": "apply_status", "status": "weak", "stacks": 1}]}, "plus5": {"name": "작은 벼락", "cost": {"neigong": 0, "mana": 3}}}, "flavor": "하늘이 하얗게 갈라졌다. 떨어진 자리에서 탄내가 났다."},
