  {"id": "law_blood_price", "name": "피의 값", "kind": "trait", "description": "굽이의 법칙. 피해 +3. 공격 카드를 낼 때마다 체력 1을 잃는다.", "glyph": "償", "decay": 0, "modifiers": {"damageDealtAddPerStack": 3}, "triggers": [{"on": "cardPlayed", "cardType": "attack", "ownCards": true, "effects": [{"op": "lose_hp", "amount": 1, "target": "self"}]}]},
  {"id": "blood_cover_fading", "name": "옅어지는 피의 덮개", "kind": "buff", "description": "사무결의 잔향. 피가 결을 덮어 결 노출이 붙지 않는다. 덮개는 곧 옅어지고, 잔향은 세 턴마다 다시 두른다.", "glyph": "血", "decay": 1, "special": "blood_cover"},
  {"id": "smoke", "name": "연막", "kind": "buff", "description": "연막에 가려 이번 라운드에 받는 피해가 0이다.", "glyph": "煙", "decay": 1, "decayAt": "roundEnd", "modifiers": {"damageTakenMul": 0}}
