  {"id": "p_mountain_body", "name": "산의 소리", "kind": "buff", "description": "차례가 시작될 때마다 방어 5(스택마다).", "glyph": "山", "decay": 0, "triggers": [{"on": "turnStart", "effects": [{"op": "block", "amount": 5, "target": "self"}]}]},
  {"id": "p_payback", "name": "되갚기", "kind": "buff", "description": "공격을 맞을 때마다(방어로 막아도) 때린 적에게 피해 3(스택마다).", "glyph": "報", "decay": 0, "triggers": [{"on": "attacked", "effects": [{"op": "damage", "amount": 3, "target": "trigger_enemy"}]}]},
  {"id": "daze", "name": "어지러움", "kind": "debuff", "description": "차례가 시작될 때 손패에서 무작위 카드 1장을 버린다.", "glyph": "眩", "decay": 1, "triggers": [{"on": "turnStart", "perStack": false, "effects": [{"op": "discard", "amount": 1}]}]},
  {"id": "breath_broken", "name": "끊긴 숨", "kind": "debuff", "description": "청운호흡의 박자가 흐트러졌다. 차례가 시작될 때 하운의 카드 1장을 버린다(스택마다).", "glyph": "斷", "decay": 1, "triggers": [{"on": "turnStart", "effects": [{"op": "discard", "amount": 1, "filter": {"owner": "haun"}}]}]},
