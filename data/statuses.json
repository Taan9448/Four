  { "id": "blood_cover", "name": "피의 덮개", "kind": "trait", "description": "천마혈공. 피가 결을 덮어 결 노출이 붙지 않는다. 천외귀운이 덮개를 벗긴다.", "glyph": "血", "decay": 0, "special": "blood_cover" },
